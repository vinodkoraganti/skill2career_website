# ==========================================
# Skill2Career Platform Environment Config
# ==========================================

# Server-Side Gemini API Key (Required for high-thinking resume analysis & recommendations)
# Injected automatically in Google AI Studio or configured in deployment secrets
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Host Application URL
APP_URL="http://localhost:3000"

# Port (Defaults to 3000)
PORT=3000

# Client-Side Firebase Configuration (Optional if running external Firebase Project)
VITE_FIREBASE_API_KEY="AIzaSyPlaceholderKeyForClient"
VITE_FIREBASE_AUTH_DOMAIN="skill2career-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="skill2career-app"
VITE_FIREBASE_STORAGE_BUCKET="skill2career-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
